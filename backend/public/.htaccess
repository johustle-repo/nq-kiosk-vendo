# Vendo Kiosk — Hostinger (LiteSpeed/Apache) front-controller routing.
Options -Indexes

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Force HTTPS (Hostinger SSL must be active for the subdomain).
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !=https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # Pass the Authorization header through to PHP (needed for device bearer tokens).
  RewriteCond %{HTTP:Authorization} .
  RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

  # Block dotfiles (.env, .git, ...) if anything is ever uploaded here by mistake.
  RewriteRule (^|/)\. - [F,L]

  # Serve real static files directly; everything else goes to index.php.
  RewriteCond %{REQUEST_FILENAME} -f
  RewriteRule ^assets/ - [L]
  RewriteRule ^ index.php [L,QSA]
</IfModule>

<FilesMatch "\.(env|sql|md|log|ini|sh)$">
  Require all denied
</FilesMatch>
