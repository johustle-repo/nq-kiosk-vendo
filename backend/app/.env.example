# Vendo Kiosk backend configuration TEMPLATE.
# Copy to ".env" in the SAME private folder (vendo_app/.env, outside public_html)
# and fill in real values. Never commit .env or upload it into public_html.

APP_ENV=production
APP_URL=https://vendo-kiosk.ebnleadgen.online

# MySQL database created in hPanel → Databases → MySQL Databases.
DB_DRIVER=mysql
DB_HOST=localhost
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASS=

# One-time token for the /setup page (first admin + migrations).
# Generate 32+ random characters, e.g.  php -r "echo bin2hex(random_bytes(24));"
# DELETE this line after setup is complete.
SETUP_TOKEN=

# Admin session cookie requires HTTPS. Only set to 0 for local http testing.
SESSION_SECURE=1

# Devices not heard from within these many seconds are shown as OFFLINE.
PHONE_STALE_SECONDS=120
CONTROLLER_STALE_SECONDS=90

# Leave empty unless /diagnostics shows REMOTE_ADDR is a proxy/CDN address.
# Then set to the $_SERVER key that carries the real client IP, e.g. HTTP_X_FORWARDED_FOR
TRUSTED_IP_HEADER=
